# Environment Variables Configuration Template for EventCraft Platform
# DO NOT COMMIT REAL SECRETS TO THIS FILE. USE LOCAL USER-SECRETS OR ENVIRONMENT VARIABLES.

# ASP.NET Core API Secrets
ConnectionStrings__DefaultConnection=Host=YOUR_NEON_POSTGRES_HOST;Database=neondb;Username=neondb_owner;Password=YOUR_POSTGRES_PASSWORD;SSL Mode=VerifyFull;
JwtSettings__SecretKey=YOUR_GENERATED_64_BYTE_JWT_SECRET_KEY
JwtSettings__Issuer=EventCraft.Api
JwtSettings__Audience=EventCraft.Client

# Python AI Subsystem & Weather Integration
OPENWEATHER_API_KEY=YOUR_OPENWEATHERMAP_API_KEY
AI_SERVICE_PORT=8000
